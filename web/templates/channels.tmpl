{{define "content"}}
{{if not .CipherOK}}
<div class="alert alert-warning">密钥库未启用（缺少 SECURITY__API_KEY_ENCRYPTION_KEY）：通知渠道功能不可用，notify 任务仅可使用 payload 内联邮件收件人。</div>
{{end}}

<div class="panel panel-default">
  <div class="panel-heading">渠道列表</div>
  <table class="table table-striped table-hover data">
    <thead><tr>
      <th>名称</th><th>类型</th><th>状态</th><th>更新人</th><th>更新时间</th><th class="op-col"></th>
    </tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono-cell">{{.Name}}</td>
        <td>{{.TypeText}} <span class="cell-sub">{{.Type}}</span></td>
        <td><span class="label label-{{.EnabledBadge}}">{{.Enabled}}</span></td>
        <td>{{.UpdatedBy}}</td>
        <td>{{.UpdatedAt}}</td>
        <td class="op-cell">
          <form method="post" action="/console/channels/{{.Name}}/toggle" class="inline-form">
            <button class="btn btn-default btn-xs" type="submit">{{if eq .Enabled "启用"}}停用{{else}}启用{{end}}</button>
          </form>
          <form method="post" action="/console/channels/{{.Name}}/test" class="inline-form">
            <button class="btn btn-info btn-xs" type="submit">测试</button>
          </form>
          <form method="post" action="/console/channels/{{.Name}}/delete" class="inline-form"
                onsubmit="return confirm('确定删除渠道 {{.Name}}？引用它的 notify 任务将发送失败。');">
            <button class="btn btn-danger btn-xs" type="submit">删除</button>
          </form>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="6" class="empty">暂无渠道——用下方表单创建（钉钉/飞书群机器人 webhook、邮件组或通用 webhook）</td></tr>
    {{end}}
    </tbody>
  </table>
</div>

{{if .CipherOK}}
<div class="panel panel-default">
  <div class="panel-heading">{{if .Items}}新建 / 更新（同名即覆盖配置）{{else}}新建渠道{{end}}</div>
  <div class="panel-body">
    <form method="post" action="/console/channels" class="form-horizontal" id="channel-create-form">
      <div class="form-group">
        <label class="col-sm-2 control-label" for="ch-name">名称</label>
        <div class="col-sm-4">
          <input type="text" class="form-control" id="ch-name" name="name" placeholder="如 ops-dingtalk（小写 [a-z0-9_-]）">
        </div>
        <label class="col-sm-2 control-label" for="ch-type">类型</label>
        <div class="col-sm-4">
          <select name="type" id="ch-type" class="form-control">
            {{range .TypeKeys}}<option value="{{.}}">{{index $.TypeLabels .}}（{{.}}）</option>{{end}}
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label" for="ch-config">config（JSON）</label>
        <div class="col-sm-10">
          <div class="code-editor cm-host" data-code-editor="json" style="height:180px">
            <textarea name="config" id="ch-config" spellcheck="false"
              placeholder='钉钉/飞书/Teams：{"webhook":"https://..."}（钉钉/飞书可加 "sign_secret"）&#10;邮件组：{"to":["ops@x.com"]}&#10;通用 webhook：{"url":"https://...","body":"{\"msgtype\":\"markdown\",\"markdown\":{\"content\":\"{{ "{{.text}}" }}\"}}","headers":{}}'></textarea>
          </div>
          <span class="help-block">写入后加密保存、不可再查看；加签密钥与 webhook 地址均为凭据。任务 payload 里用 {"channel":"名称"} 引用。</span>
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <button type="submit" class="btn btn-primary">保存渠道</button>
        </div>
      </div>
    </form>
  </div>
</div>
{{end}}
{{end}}
