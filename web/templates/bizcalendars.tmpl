{{define "content"}}
<div class="toolbar">
  <ul class="nav nav-pills filter-pills">
    <li role="presentation" {{if eq .Selected ""}}class="active"{{end}}><a href="/console/calendars">全部日历</a></li>
    {{range .Items}}
    <li role="presentation" {{if eq .Selected .Name}}class="active"{{end}}><a href="/console/calendars?calendar={{.Name}}">{{.Name}}</a></li>
    {{end}}
  </ul>
</div>

<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">日历列表</span></div>
  <table class="table table-striped table-hover data">
    <thead><tr><th>名称</th><th>说明</th><th>日期数</th><th>更新时间</th><th class="op-col"></th></tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono-cell"><a href="/console/calendars?calendar={{.Name}}">{{.Name}}</a></td>
        <td>{{.Description}}</td>
        <td>{{.Dates}}</td>
        <td>{{.UpdatedAt}}</td>
        <td class="op-cell">
          <form method="post" action="/console/calendars/{{.Name}}/delete" class="inline-form"
                onsubmit="return confirm('确定删除日历 {{.Name}}？引用它的 cron 任务将停止扩展（fail-loud）。');">
            <button class="btn btn-danger btn-xs" type="submit">删除</button>
          </form>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="5" class="empty">暂无日历——创建后可在任务创建时选择，用于跳过节假日/调休补班</td></tr>
    {{end}}
    </tbody>
  </table>
</div>

{{if .Selected}}
<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">日期覆盖（{{.Selected}}）</span></div>
  <table class="table table-striped data">
    <thead><tr><th>日期</th><th>类型</th><th class="op-col"></th></tr></thead>
    <tbody>
    {{range .Dates}}
      <tr>
        <td class="mono-cell">{{.Date}}</td>
        <td>{{.DayTypeText}} <span class="cell-sub">{{.DayType}}</span></td>
        <td class="op-cell">
          <form method="post" action="/console/calendars/{{$.Selected}}/dates/{{.Date}}/delete" class="inline-form">
            <button class="btn btn-danger btn-xs" type="submit">移除</button>
          </form>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="3" class="empty">该日历暂无日期覆盖</td></tr>
    {{end}}
    </tbody>
  </table>
  <div class="panel-body">
    <form method="post" action="/console/calendars/{{.Selected}}/dates" class="form-inline">
      <input type="date" name="date" class="form-control" required>
      <select name="day_type" class="form-control">
        <option value="off">off（休：跳过触发）</option>
        <option value="work">work（班：调休补班触发）</option>
      </select>
      <button type="submit" class="btn btn-primary">设置日期</button>
      <span class="help-block" style="display:inline">work 日期按周一参与星期匹配（调休周六会让 <code>1-5</code> 的 cron 触发）</span>
    </form>
  </div>
</div>
{{end}}

<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">新建日历</span></div>
  <div class="panel-body">
    <form method="post" action="/console/calendars" class="form-inline">
      <input type="text" name="name" class="form-control" placeholder="名称（如 cn-holidays）" required>
      <input type="text" name="description" class="form-control" placeholder="说明（如 中国法定节假日 2026）" size="40">
      <button type="submit" class="btn btn-primary">创建</button>
    </form>
  </div>
</div>
{{end}}
